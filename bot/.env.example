# ---------------------------------------------------------------- بات بله
# توکن باتی که در بله ساخته‌اید (BotFather بله).
BALE_BOT_TOKEN=

# نشانی API بله (تغییر ندهید مگر بله نشانی تازه اعلام کند).
BALE_API_BASE=https://tapi.bale.ai

# شناسهٔ گفت‌وگوی شما در بله (فقط همین شناسه‌ها می‌توانند لایسنس صادر/لغو کنند).
# برای گرفتنش به بات خودتان /whoami بفرستید. چند شناسه را با کاما جدا کنید.
ADMIN_CHAT_IDS=

# ---------------------------------------------------------------- لایسنس
# کلید خصوصی ریشه؛ اگر خالی باشد از فایل keys/root_private.key خوانده می‌شود.
# روی میزبانی امن‌تر است اینجا بگذارید تا در فایل‌های پروژه نباشد.
SABA_ROOT_PRIVATE_KEY=
SABA_ROOT_PUBLIC_KEY=

# پیش‌فرض‌های صدور لایسنس
DEFAULT_EDITION=premium
# مدت پیش‌فرض به «روز» (۳۶۵ = یک سال؛ صفر = بدون انقضا)
DEFAULT_DAYS=365
DEFAULT_MONTHS=12
DEFAULT_SEATS=3

# توکن مدیر برای تأیید درخواست‌ها از داخل برنامهٔ فروشنده.
# همان مقدار را هنگام نصب نسخهٔ فروشنده در فیلد «توکن مدیر» بدهید.
# اگر خالی بماند، تأیید فقط از بات بله انجام می‌شود (پنل برنامه بسته است).
SABA_ADMIN_TOKEN=

# چند روز بی‌اتصال بودن برای برنامهٔ مشتری مجاز است پیش از قفل شدن.
GRACE_DAYS=15

# ---------------------------------------------------------------- عمومی
# نشانی عمومی همین سرویس (پس از استقرار پر کنید؛ فقط برای نمایش است).
PUBLIC_URL=
# کلید نرم‌افزاری برای برنامهٔ مشتری (اختیاری؛ اگر پر شود، برنامه باید همان را
# بفرستد). مرز امنیتی واقعی نیست، فقط جلوی اسکن‌های سرگردان را می‌گیرد.
CLIENT_TOKEN=
# سقف درخواست هر IP در ساعت
RATE_LIMIT_PER_HOUR=60
# پیام «سرور بالا آمد» به مدیران
STARTUP_PING=0
# نشانی پایگاه‌داده (پیش‌فرض: data/bot.db)
BOT_DB_PATH=
# نام فروشنده (در پیام‌ها نمایش داده می‌شود)
OWNER_NAME=فروشنده
